{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnPen",
  "version": "0.1.0",
  "identifier": "dev.personal.monitorink",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../docs/GETTING-STARTED.md": "GETTING-STARTED.md",
      "../docs/INSTALL.ko.md": "INSTALL.ko.md",
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../docs/USER-GUIDE.ko.md": "USER-GUIDE.ko.md",
      "../third-party-sources.zip": "third-party-sources.zip",
      "../docs/README.ja.md": "README.ja.md",
      "../docs/README.zh-CN.md": "README.zh-CN.md",
      "../docs/STT-SETUP.md": "STT-SETUP.md",
      "../stt/worker.py": "stt/worker.py",
      "../stt/providers.py": "stt/providers.py",
      "../stt/acceleration.py": "stt/acceleration.py",
      "../stt/requirements.txt": "stt/requirements.txt",
      "../stt/setup-windows.ps1": "stt/setup-windows.ps1"
    },
    "shortDescription": "Draw over your screen. Keep the conversation moving.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Korean",
          "Japanese",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
